<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Car App Library minimum API level. v1 = Android Auto
             basic support; required by modern Auto hosts to
             negotiate the template protocol. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="2" />

        <service
            android:name="com.dmzs.datawatchclient.auto.messaging.DatawatchMessagingService"
            android:exported="true"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService"/>
                <!-- MESSAGING category required for CarAppExtender Reply/Play notification
                     actions. Conversation context ([You]/[datawatch]) is shown on every
                     detail screen before any reply flow. MessagingStyle on phone
                     notifications. ADR-0049 supersedes ADR-0031. -->
                <category android:name="androidx.car.app.category.MESSAGING"/>
            </intent-filter>
        </service>
    </application>
</manifest>
