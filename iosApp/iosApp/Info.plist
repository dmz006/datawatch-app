<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <!-- Version synced from gradle.properties via CI / build-ios-framework.sh -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- D84b deep links (source of truth: project.yml info.properties). -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.dmzs.datawatchclient</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>datawatch</string>
            </array>
        </dict>
    </array>

    <!-- Orientations: App Store validation requires all four on iPad (multitasking). -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Push notifications: APNs background delivery -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>

    <!-- Microphone: Whisper voice transcription -->
    <key>NSMicrophoneUsageDescription</key>
    <string>datawatch uses the microphone to record voice commands for transcription via your configured Whisper backend.</string>

    <!-- Camera: "Take a photo" image attach in session replies -->
    <key>NSCameraUsageDescription</key>
    <string>datawatch uses the camera when you take a photo to attach to a session reply.</string>

    <!-- Biometrics: Face ID / Touch ID for token-protected profiles -->
    <key>NSFaceIDUsageDescription</key>
    <string>datawatch uses Face ID to protect access to your server profiles.</string>

    <!-- Local network: user-configured servers may be on the LAN -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>datawatch connects to server addresses you configure, which may be on your local network.</string>

    <!--
      App Transport Security stays at its defaults: HTTPS only, matching the
      Android network_security_config (cleartext blocked). Self-signed servers
      are supported by installing the server CA on the device (Edit Server →
      Download CA certificate) or the per-profile trust-all client.
    -->

    <!-- Export compliance: standard TLS only (exempt) — skips the per-build questionnaire -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
