<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Car App Library minimum API level. v1 = Android Auto
             basic support; required by modern Auto hosts to
             negotiate the template protocol. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="2" />

        <service
            android:name="com.dmzs.datawatchclient.auto.messaging.DatawatchMessagingService"
            android:exported="true"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService"/>
                <!-- OTHER, not MESSAGING: Play Store messaging-quality guidelines require
                     MessagingTemplate root + conversation history which this app does not
                     implement. Our app is a terminal/AI session monitor, not a messaging
                     app. CarAppExtender notifications (Play/Reply buttons) work with both
                     categories (ADR-0031 rev 2026-09-14). -->
                <category android:name="androidx.car.app.category.OTHER"/>
            </intent-filter>
        </service>
    </application>
</manifest>
