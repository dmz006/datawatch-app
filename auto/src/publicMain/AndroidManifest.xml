<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Car App Library minimum API level. v1 = Android Auto
             basic support; required by modern Auto hosts to
             negotiate the template protocol. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="2" />

        <service
            android:name="com.dmzs.datawatchclient.auto.messaging.DatawatchMessagingService"
            android:exported="true"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService"/>
                <!-- IOT (Internet of Things) is the correct Play Store category for a
                     monitoring/terminal app. No template prescription — any Car App Library
                     template works. MESSAGING was rejected for not implementing MessageTemplate
                     semantics; OTHER is not a valid Play Store category string. -->
                <category android:name="androidx.car.app.category.IOT"/>
            </intent-filter>
        </service>
    </application>
</manifest>
