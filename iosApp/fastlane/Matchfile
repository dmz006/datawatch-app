# fastlane match certificate/profile management
# Replace git_url with your private certs repo before running.
#
# Setup: fastlane match init
# Usage: fastlane match appstore --readonly

# git_url("https://github.com/your-org/datawatch-ios-certs")
# App + its WidgetKit extension (BL403). The widget bundle id must exist in the
# Apple Developer portal before match can make its profile:
#   fastlane register_widget_bundle
app_identifier(["com.dmzs.datawatchclient", "com.dmzs.datawatchclient.widgets"])
# Apple ID comes from the FASTLANE_USER env var when running locally; CI
# authenticates with the App Store Connect API key and needs no Apple ID.
