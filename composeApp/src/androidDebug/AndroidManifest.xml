<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG builds only: Android Automotive OS (AAOS) entry point for emulator
     screenshot passes (.github/workflows/android-screenshots.yml, job aaos;
     scripts/screenshots/capture-aaos.sh). CarAppActivity (app-automotive,
     debug dependency only) hosts the same CarAppService the phone uses for
     Android Auto. No LAUNCHER category, so phone debug installs get no extra
     icon; the capture script starts it by component. Release builds never
     contain this activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="androidx.car.app.activity.CarAppActivity"
            android:exported="true"
            android:label="datawatch"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />
    </application>
</manifest>
