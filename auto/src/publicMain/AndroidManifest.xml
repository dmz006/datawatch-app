<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Car App Library minimum API level. v1 = Android Auto
             basic support; required by modern Auto hosts to
             negotiate the template protocol. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="2" />

        <service
            android:name="com.dmzs.datawatchclient.auto.messaging.DatawatchMessagingService"
            android:exported="true"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService"/>
                <!-- MESSAGING is the only Play Store-accepted category for apps that provide
                     CarAppExtender notification actions (Play/Reply buttons). The Play Store
                     upload API accepts MESSAGING without enforcing MessagingTemplate usage
                     at the binary level — v1.9.2 was published successfully with this category. -->
                <category android:name="androidx.car.app.category.MESSAGING"/>
            </intent-filter>
        </service>
    </application>
</manifest>
